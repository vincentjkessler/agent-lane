{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-lane:alp:verification-result:1.0-candidate.1",
  "title": "ALP Verification Result 1.0 Candidate",
  "type": "object",
  "required": ["verifier_id", "verifier_version", "input_identity", "assertions", "status"],
  "properties": {
    "verifier_id": {"type": "string", "minLength": 1},
    "verifier_version": {"type": "string", "minLength": 1},
    "input_identity": {"type": "object"},
    "assertions": {"type": "array", "minItems": 1},
    "status": {"enum": ["PASS", "FAIL", "NOT_ASSERTABLE"]}
  }
}
